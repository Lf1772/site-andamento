# Banco de dados PostgreSQL
DATABASE_URL=postgres://andamento:senha@localhost:5432/andamento

# Chave da API da Anthropic (fica apenas no servidor; nunca é enviada ao navegador)
ANTHROPIC_API_KEY=
# Modelo de IA utilizado na análise e na redação
AI_MODEL=claude-opus-5-5
# Reexecução automática em outro modelo caso o modelo principal recuse a solicitação ("default" ou "off")
AI_FALLBACKS=default

# Armazenamento privado dos documentos (fora da pasta pública)
STORAGE_DIR=./storage
# Chave AES-256 em base64 (32 bytes). Gere com: openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=

# Limites de uso
MAX_FILE_MB=200
MAX_PAGES_PER_DOCUMENT=3000
# Teto de tokens de entrada (estimados) por análise, para controle de custos
MAX_TOKENS_PER_ANALYSIS=1500000
# Acima deste volume, o processo é lido em partes (map-reduce)
SINGLE_PASS_TOKEN_LIMIT=300000
# Teto de páginas digitalizadas enviadas para OCR por documento
MAX_OCR_PAGES_PER_DOCUMENT=400

# Sessão
SESSION_HOURS=12

# Usuário administrador inicial (usado por npm run db:seed)
SEED_ESCRITORIO_NOME="Escritório Modelo Advocacia"
SEED_ADMIN_NOME="Administrador"
SEED_ADMIN_EMAIL=admin@escritorio.com.br
SEED_ADMIN_SENHA=
